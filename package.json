{
  "name": "dsh-superpowers",
  "version": "6.3.0",
  "description": "Superpowers (obra/superpowers v6.3.0) skills + session bootstrap adapted for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "skills",
    "preset",
    "references",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SOURCES.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.9.0",
    "@types/node": "^22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "vendor": "node scripts/vendor-skills.mjs",
    "vendor:validate": "node scripts/vendor-skills.mjs --validate",
    "generate:preset": "node scripts/generate-preset.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-superpowers",
    "plugin",
    "superpowers",
    "skills",
    "tdd",
    "debugging",
    "workflows",
    "brainstorming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stillU/dsh-superpowers.git"
  },
  "homepage": "https://github.com/stillU/dsh-superpowers",
  "bugs": {
    "url": "https://github.com/stillU/dsh-superpowers/issues"
  },
  "author": {
    "name": "stillU",
    "url": "https://github.com/stillU"
  },
  "publishConfig": {
    "access": "public"
  }
}
